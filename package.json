{
  "name": "polla_futbolera",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "concurrently -n backend,frontend -c cyan,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:docker": "docker compose up --build",
    "dev:docker:down": "docker compose down",
    "docker:prod": "docker compose -f docker-compose.prod.yml up --build",
    "build": "npm --workspace backend run build && npm --workspace frontend run build"
  },
